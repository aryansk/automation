      "id": "9b0648c9-7ff0-4f53-bb15-9facef24356b",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 304],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const form = $('Receive Post').first();\nconst binary = form.binary || {};\nconst caption = form.json['Caption'] || '';\nconst postType = form.json['Post Type'] || '';\nconst out = [];\nlet i = 0;\nfor (const key of Object.keys(binary)) {\n  const b = binary[key];\n  out.push({\n    json: {\n      fileName: b.fileName || ('file_' + i),\n      mimeType: b.mimeType,\n      dataUri: 'data:' + b.mimeType + ';base64,' + b.data,\n      caption: caption,\n      postType: postType,\n      index: i\n    }\n  });\n  i++;\n}\nif (out.length === 0) { throw new Error('No files were uploaded'); }\nreturn out;"
      },
      "id": "a351b123-0c5c-4d4a-b0d8-a49db3547193",
      "name": "Prepare Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 304]
    },
    {
