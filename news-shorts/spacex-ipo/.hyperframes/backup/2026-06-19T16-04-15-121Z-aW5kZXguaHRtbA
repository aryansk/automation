/* ── Caption renderer (matches reference pattern) ── */
(function () {
  if (!window.CAPTION_DATA || !window.CAPTION_DATA.scenes) return;
  var data  = window.CAPTION_DATA;
  var style = data.style || {};
  var fontDisplay = style.font_display || '"Newsreader", Georgia, serif';
  var accent  = style.accent  || "#E8363D";
  var surface = style.surface || "#10121C";

  function _relLum(hex) {
    var c = (hex || "").trim().replace(/^#/, "");
    if (c.length === 3) c = c.replace(/(.)/g, "$1$1");
    if (c.length !== 6) return null;
    var ch = [0,1,2].map(function(i){
      var v = parseInt(c.substr(i*2,2),16)/255;
      return v <= 0.03928 ? v/12.92 : Math.pow((v+0.055)/1.055, 2.4);
    });
    return 0.2126*ch[0] + 0.7152*ch[1] + 0.0722*ch[2];
  }
  function _contrast(a,b){
    var la=_relLum(a), lb=_relLum(b);
    if(la==null||lb==null) return 1;
    return (Math.max(la,lb)+0.05)/(Math.min(la,lb)+0.05);
  }
  function readableInk(bgHex){
    var passing=[style.fg,style.bg].filter(Boolean).filter(function(c){return _contrast(c,bgHex)>=4.5;});
    if(passing.length){ return passing.sort(function(a,b){return _contrast(b,bgHex)-_contrast(a,bgHex);})[0]; }
    return _contrast("#FFFFFF",bgHex)>=_contrast("#111111",bgHex)?"#FFFFFF":"#111111";
  }
  var ink = readableInk(surface);

  var ALL = [];
  Object.keys(data.scenes).forEach(function(sid){
    var s = data.scenes[sid]||{};
    var offset = s.start||0;
    (s.words||[]).forEach(function(w){
      ALL.push({text:w.text, start:w.start+offset, end:w.end+offset});
    });
  });

  var GROUPS = [];
  var cur = [];
  ALL.forEach(function(w,i){
    cur.push(w);
    var nw = ALL[i+1];
    var pause = nw ? nw.start - w.end : 0;
    var punc  = /[,.:!?]$/.test(w.text);
    if(cur.length >= 4 || !nw || punc || pause >= 0.35){
      GROUPS.push({words:cur.slice(), start:cur[0].start, end:cur[cur.length-1].end});
      cur = [];
    }
  });

  var stage = document.getElementById("caption-stage");
  var tl = gsap.timeline({paused:true});
  GROUPS.forEach(function(g,gi){
    var pill = document.createElement("div");
    pill.id = "cg-" + gi;
    pill.style.cssText = [
      "position:absolute; left:50%; transform:translateX(-50%); bottom:0;",
      "padding:14px 28px; background:" + surface + ";",
      "color:" + ink + ";",
      "font: 900 44px/1.2 " + fontDisplay + ";",
      "letter-spacing:0.5px; text-transform:uppercase; white-space:normal;",
      "text-align:center; max-width:90%; box-sizing:border-box;",
      "border:4px solid " + ink + ";",
      "box-shadow:8px 8px 0 " + accent + ";",
      "opacity:0;"
    ].join(" ");
    pill.textContent = g.words.map(function(w){return w.text;}).join(" ");
    stage.appendChild(pill);

    var nextStart = GROUPS[gi+1] ? GROUPS[gi+1].start : (g.end+0.4);
    var gap       = nextStart - g.end;
    var visibleEnd = (gap>0 && gap<=0.8) ? nextStart : Math.min(nextStart, g.end+0.3);

    tl.fromTo(pill,{opacity:0},{opacity:1,duration:0.15,ease:"power1.out",overwrite:"auto"},g.start);
    tl.to(pill,{opacity:0,duration:0.12,ease:"power1.in",overwrite:"auto"},Math.max(g.start+0.15,visibleEnd));
  });
  window.__timelines = window.__timelines || {};
  window.__timelines["captions"] = tl;
})();

