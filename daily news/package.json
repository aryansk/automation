{
  "name": "daily-news",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-world-data.mjs && node scripts/build-city-data.mjs",
    "validate:story": "node scripts/validate-story.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "setup:tts": "node scripts/setup-tts.mjs",
    "narrate": "node scripts/generate-narration.mjs",
    "dev": "npx --yes hyperframes@0.7.87 preview",
    "check": "npx --yes hyperframes@0.7.87 check",
    "snapshot": "npx --yes hyperframes@0.7.87 snapshot --at 2.5,6.0,9.2,12.5,17",
    "render": "npx --yes hyperframes@0.7.87 render",
    "build:top3": "node scripts/build-top3.mjs",
    "publish": "npx --yes hyperframes@0.7.87 publish",
    "test": "node --test tests/*.test.mjs",
    "build:globe": "node scripts/build-globe-tour.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "three": "^0.181.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
