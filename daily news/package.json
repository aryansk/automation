{
  "name": "daily-news",
  "private": true,
  "type": "module",
  "scripts": {
    "build:data": "node scripts/build-world-data.mjs && node scripts/build-city-data.mjs",
    "validate:story": "node scripts/validate-story.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "validate:demo-story": "node scripts/validate-demo-story.mjs",
    "setup:tts": "node scripts/setup-tts.mjs",
    "narrate": "node scripts/generate-narration.mjs",
    "dev": "npx --yes hyperframes@0.7.106 preview",
    "check": "npx --yes hyperframes@0.7.106 check",
    "snapshot": "npx --yes hyperframes@0.7.106 snapshot --at 2.5,6.0,9.2,12.5,17",
    "prerender": "node ../scripts/update-hyperframes.mjs --project . --no-skills",
    "render": "npx --yes hyperframes@0.7.106 render",
    "update:hyperframes": "node ../scripts/update-hyperframes.mjs --project . --no-skills",
    "check:hyperframes-update": "node ../scripts/update-hyperframes.mjs --project . --check",
    "build:top3": "node scripts/build-top3.mjs",
    "build:standalone": "node scripts/build-one-topic.mjs",
    "build:landscape-topic": "node scripts/build-landscape-topic.mjs",
    "build:model-topic": "node scripts/build-model-topic.mjs",
    "validate:bundle": "node scripts/validate-daily-bundle.mjs",
    "publish": "npx --yes hyperframes@0.7.106 publish",
    "test": "node --test tests/*.test.mjs",
    "build:globe": "node scripts/build-globe-tour.mjs",
    "animations:list": "node scripts/list-globe-map-animations.mjs",
    "cleanup:uploaded": "node scripts/cleanup-uploaded-renders.mjs"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "three": "^0.181.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
